rules_version = '2';
// Market Sentinel n'utilise Firestore que depuis son serveur Cloud Run (compte de service Google, non soumis à ces
// règles). Tout accès direct depuis l'extérieur (navigateur, API publique de Firebase) est donc refusé.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
